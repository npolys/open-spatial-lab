{
  "name": "open-spatial-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained local Web of Worlds spatial-computing demo.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "start": "bash ./launchOpenSpatialLab.sh",
    "stop": "bash ./stopOpenSpatialLab.sh",
    "demo-check": "node tools/verify-demo.mjs",
    "release-check": "node tools/verify-release.mjs",
    "verify": "npm run release-check && npm run demo-check",
    "render-adapter-check": "node tools/verify-render-adapters.mjs",
    "wowapi-smoke-check": "node tools/verify-wowapi-smoke.mjs",
    "generate-release-manifest": "node tools/generate-release-manifest.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.3.3",
    "three": "0.173.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "5.2.2",
    "puppeteer-core": "22.15.0"
  }
}
